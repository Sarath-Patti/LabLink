# LabLink Environment Variables Example Template
# Copy to .env for local development override (DO NOT COMMIT SECRETS)

LABLINK_ENV=development
LABLINK_LOG_LEVEL=INFO

# Transport & Communication
LABLINK_TCP_HOST=127.0.0.1
LABLINK_TCP_PORT=5025
LABLINK_TCP_TIMEOUT=5.0
LABLINK_SERIAL_PORT=COM1
LABLINK_SERIAL_BAUDRATE=9600
LABLINK_SERIAL_BYTESIZE=8
LABLINK_SERIAL_PARITY=N
LABLINK_SERIAL_STOPBITS=1.0
LABLINK_SERIAL_TIMEOUT=2.0
LABLINK_ETH_INTERFACE=eth0

# Protocols & SCPI
LABLINK_SCPI_TIMEOUT_MS=5000

# Database Persistence (Secrets set via environment only)
LABLINK_DB_HOST=localhost
LABLINK_DB_PORT=5432
LABLINK_DB_NAME=lablink_db
LABLINK_DB_USER=lablink_user
LABLINK_DB_PASSWORD=your_secure_password_here
LABLINK_DB_MAX_CONN=10

# Simulators
LABLINK_SIMULATORS_ENABLED=false
LABLINK_SIM_TCP_PORT=9001
