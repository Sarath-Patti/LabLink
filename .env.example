# LabLink Environment Configuration Template

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development

# Persistence Configuration
LABLINK_PERSISTENCE_PROVIDER=PostgreSQL
LABLINK_DB_HOST=localhost
LABLINK_DB_PORT=5432
LABLINK_DB_NAME=lablink_dev
LABLINK_DB_USER=lablink_user
LABLINK_DB_PASSWORD=lablink_pass

# Docker Compose Environment
POSTGRES_DB=lablink_dev
POSTGRES_USER=lablink_user
POSTGRES_PASSWORD=lablink_pass
